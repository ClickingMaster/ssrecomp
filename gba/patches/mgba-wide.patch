@@ -21,6 +22,19 @@ struct GBAVideoRendererSprite {
 };
 
 int GBAVideoRendererCleanOAM(struct GBAObj* oam, struct GBAVideoRendererSprite* sprites, int offsetY);
+// Widescreen: as GBAVideoRendererCleanOAM, keeping sprites visible in the extra columns
+int GBAVideoRendererCleanOAMWide(struct GBAObj* oam, struct GBAVideoRendererSprite* sprites, int offsetY, int wideExtra);
+
+// A sprite's 9-bit x as a screen position. On the GBA, 256-511 are -256 to -1. In a wide
+// frame, anything left of 240 + wideExtra is on screen to the right instead (the game puts
+// sprites there to show them in the right-hand columns); the rest is still negative.
+static inline int32_t GBAVideoWideObjX(unsigned x9, int wideExtra) {
+	x9 &= 0x1FF;
+	if (wideExtra > 0) {
+		return (int32_t) x9 < GBA_VIDEO_HORIZONTAL_PIXELS + wideExtra ? (int32_t) x9 : (int32_t) x9 - 512;
+	}
+	return ((int32_t) (x9 << 23)) >> 23;
+}
 
 CXX_GUARD_END
 
