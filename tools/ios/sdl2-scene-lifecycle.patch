+static void UIKit_LogScene(const char *event, UIWindowScene *scene)
+{
+    CGRect bounds = scene ? scene.coordinateSpace.bounds : CGRectZero;
+    fprintf(stderr, "[ios-scene] %s delegate=%s scene=%p session=%s state=%ld screen=%p bounds=%.0fx%.0f main-thread=%d\n",
