@@ -50,6 +50,53 @@ static int forward_argc;
 static char **forward_argv;
 static int exit_status;
 
+/* Fulldex: single-scene lifecycle backport for the pinned SDL2 backend. */
+static UIWindowScene *fulldexScene;
+static BOOL fulldexMainStarted;
+static NSSet<UIOpenURLContext *> *fulldexLaunchURLs;
+
+@interface SDLUIKitDelegate (FulldexScene)
+- (void)postFinishLaunch;
+- (void)sendDropFileForURL:(NSURL *)url;
+@end
+
+@interface SDLUIKitSceneDelegate : NSObject <UIWindowSceneDelegate>
+@end
+
+@implementation SDLUIKitSceneDelegate
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)options
+{
+    if (![scene isKindOfClass:[UIWindowScene class]]) return;
+    fulldexScene = (UIWindowScene *)scene;
+    UIWindow *window = [[SDLUIKitDelegate sharedAppDelegate] window];
+    if (window) {
+        window.windowScene = fulldexScene;
+        window.frame = fulldexScene.coordinateSpace.bounds;
+        [window makeKeyAndVisible];
+    }
+    if (fulldexMainStarted) {
+        [self scene:scene openURLContexts:options.URLContexts];
+    } else {
+        fulldexLaunchURLs = options.URLContexts;
+    }
+    if (!fulldexMainStarted) {
+        fulldexMainStarted = YES;
+        /* Defer SDL_main until UIKit has finished connecting the window scene. */
+        [[SDLUIKitDelegate sharedAppDelegate] performSelector:@selector(postFinishLaunch) withObject:nil afterDelay:0.0];
+    }
+}
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)contexts
+{
+    for (UIOpenURLContext *context in contexts) {
+        [[SDLUIKitDelegate sharedAppDelegate] sendDropFileForURL:context.URL];
+    }
+}
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == fulldexScene) fulldexScene = nil;
+}
+@end
