+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)contexts
+{
+    for (UIOpenURLContext *context in contexts) {
+        [[SDLUIKitDelegate sharedAppDelegate] sendDropFileForURL:context.URL];
+    }
+}
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    UIKit_LogScene("did-disconnect", (UIWindowScene *)scene);
+    if (scene == fulldexScene) {
+        [NSObject cancelPreviousPerformRequestsWithTarget:self selector:@selector(startSDLIfReady) object:nil];
+        self.mainQueued = NO;
+        fulldexScene = nil;
+    }
+}
+@end
