+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)options
+{
+    if (![scene isKindOfClass:[UIWindowScene class]] ||
+        ![session.role isEqualToString:UIWindowSceneSessionRoleApplication]) return;
+    fulldexScene = (UIWindowScene *)scene;
+    UIKit_LogScene("will-connect", fulldexScene);
+    self.window = [[SDLUIKitDelegate sharedAppDelegate] window];
+    if (!self.window) {
+        /* Give UIKit a scene-owned window while activation completes. SDL_main
+         * must not enter its event loop from willConnect or block activation. */
+        self.window = [[UIWindow alloc] initWithWindowScene:fulldexScene];
+        self.window.rootViewController = [UIViewController new];
+        self.window.rootViewController.view.backgroundColor = UIColor.blackColor;
+    }
+    self.window.windowScene = fulldexScene;
+    self.window.frame = fulldexScene.coordinateSpace.bounds;
+    [self.window makeKeyAndVisible];
+    UIKit_SyncSceneWindows(fulldexScene);
+    if (fulldexMainStarted) [self scene:scene openURLContexts:options.URLContexts];
+    else fulldexLaunchURLs = options.URLContexts;
+}
+- (void)scheduleSDLMain
+{
+    if (fulldexMainStarted || self.mainQueued) return;
+    self.mainQueued = YES;
+    [self performSelector:@selector(startSDLIfReady) withObject:nil afterDelay:0.0];
+}
+- (void)startSDLIfReady
+{
+    self.mainQueued = NO;
+    if (fulldexMainStarted) return;
+    UIWindowScene *scene = self.window.windowScene;
+    CGRect bounds = scene ? scene.coordinateSpace.bounds : CGRectZero;
+    if (scene != fulldexScene || scene.activationState != UISceneActivationStateForegroundActive ||
+        bounds.size.width <= 0 || bounds.size.height <= 0 || !scene.screen) {
+        UIKit_LogScene("waiting-for-active-geometry", scene);
+        return; /* Activation/geometry callbacks retry; never block UIKit. */
+    }
+    fulldexMainStarted = YES;
+    UIKit_LogScene("starting-SDL-main", scene);
+    [[SDLUIKitDelegate sharedAppDelegate] postFinishLaunch];
+}
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{
+    UIKit_LogScene("did-become-active", (UIWindowScene *)scene);
+    UIKit_SyncSceneWindows((UIWindowScene *)scene);
+    [self.window makeKeyAndVisible];
+    [self scheduleSDLMain];
+}
+- (void)sceneWillResignActive:(UIScene *)scene
+{
+    UIKit_LogScene("will-resign-active", (UIWindowScene *)scene);
+}
+- (void)sceneDidEnterBackground:(UIScene *)scene
+{
+    UIKit_LogScene("did-enter-background", (UIWindowScene *)scene);
+}
+- (void)sceneWillEnterForeground:(UIScene *)scene
+{
+    UIKit_LogScene("will-enter-foreground", (UIWindowScene *)scene);
+    UIKit_SyncSceneWindows((UIWindowScene *)scene);
+}
+- (void)windowScene:(UIWindowScene *)scene didUpdateCoordinateSpace:(id<UICoordinateSpace>)previousCoordinateSpace interfaceOrientation:(UIInterfaceOrientation)previousInterfaceOrientation traitCollection:(UITraitCollection *)previousTraitCollection
+{
+    UIKit_LogScene("geometry-changed", scene);
+    UIKit_SyncSceneWindows(scene);
+    [self scheduleSDLMain];
+}
+#if defined(__IPHONE_26_0) && __IPHONE_OS_VERSION_MAX_ALLOWED >= __IPHONE_26_0
+- (void)windowScene:(UIWindowScene *)scene didUpdateEffectiveGeometry:(UIWindowSceneGeometry *)previousGeometry API_AVAILABLE(ios(26.0))
+{
+    UIKit_LogScene("effective-geometry-changed", scene);
+    UIKit_SyncSceneWindows(scene);
