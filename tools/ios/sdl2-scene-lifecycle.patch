+/* Fulldex: keep one logical application display across fold/unfold screen changes. */
+void UIKit_UpdateSceneDisplay(UIWindowScene *scene)
+{
+    SDL_VideoDevice *video = SDL_GetVideoDevice();
+    if (!video || video->num_displays == 0 || !scene || !scene.screen) return;
+    SDL_VideoDisplay *display = &video->displays[0];
+    SDL_DisplayData *data = (__bridge SDL_DisplayData *)display->driverdata;
+    CGSize size = scene.coordinateSpace.bounds.size;
+    if (size.width <= 0 || size.height <= 0) return;
+    BOOL changedScreen = data.uiscreen != scene.screen;
+    if (!changedScreen && display->desktop_mode.w == (int)size.width &&
+        display->desktop_mode.h == (int)size.height) return;
+    if (changedScreen) {
+        data.uiscreen = scene.screen;
+        data.screenDPI = [[SDL_DisplayData alloc] initWithScreen:scene.screen].screenDPI;
+        /* Drop mode objects retained from the previous physical screen. */
+        for (int i = 0; i < display->num_display_modes; ++i) UIKit_FreeDisplayModeData(&display->display_modes[i]);
+        SDL_free(display->display_modes);
+        display->display_modes = NULL;
+        display->num_display_modes = display->max_display_modes = 0;
+        UIKit_FreeDisplayModeData(&display->desktop_mode);
+        UIKit_AllocateDisplayModeData(&display->desktop_mode, scene.screen.currentMode);
+    }
+    display->desktop_mode.w = (int)size.width;
+    display->desktop_mode.h = (int)size.height;
+    display->desktop_mode.refresh_rate = (int)UIKit_GetDisplayModeRefreshRate(scene.screen);
+    display->current_mode = display->desktop_mode;
+    fprintf(stderr, "[ios-display] scene=%p display=0 screen=%p points=%dx%d scale=%.2f rebound=%d\n",
+            (__bridge void *)scene, (__bridge void *)scene.screen,
+            display->desktop_mode.w, display->desktop_mode.h, (double)scene.screen.nativeScale, changedScreen);
+}
