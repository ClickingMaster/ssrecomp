+/* Reuse SDL's controllers/views and renderer across scene and display changes. */
+static void UIKit_SyncSceneWindows(UIWindowScene *scene)
+{
+    if (!scene || scene != fulldexScene) return;
+    UIKit_UpdateSceneDisplay(scene);
+    SDL_VideoDevice *video = SDL_GetVideoDevice();
+    if (!video) return;
+    for (SDL_Window *window = video->windows; window; window = window->next) {
+        SDL_WindowData *data = (__bridge SDL_WindowData *)window->driverdata;
+        if (!data || SDL_GetDisplayForWindow(window) != SDL_GetDisplay(0)) continue;
+        if (data.uiwindow.windowScene != scene) data.uiwindow.windowScene = scene;
+        data.uiwindow.frame = scene.coordinateSpace.bounds;
+        BOOL scaleChanged = NO;
+        CGFloat scale = (window->flags & SDL_WINDOW_ALLOW_HIGHDPI) ? scene.screen.nativeScale : 1.0;
+        for (UIView *view in data.views) {
+            scaleChanged |= view.contentScaleFactor != scale;
+            view.contentScaleFactor = scale;
+            [view setNeedsLayout];
+        }
+        [data.uiwindow setNeedsLayout];
+        [data.uiwindow layoutIfNeeded];
+        [data.viewcontroller.view setNeedsLayout];
+        [data.viewcontroller.view layoutIfNeeded];
+        if (scaleChanged) {
+            /* A screen may change pixel density without changing point size.
+             * Refresh SDL renderer viewports even if RESIZED was deduplicated. */
+            SDL_SendWindowEvent(window, SDL_WINDOWEVENT_SIZE_CHANGED, window->w, window->h);
+        }
+        SDL_SendWindowEvent(window, SDL_WINDOWEVENT_EXPOSED, 0, 0);
+    }
+}
+
+void UIKit_AdoptSceneWindow(UIWindow *window)
+{
+    SDLUIKitSceneDelegate *delegate = (SDLUIKitSceneDelegate *)window.windowScene.delegate;
+    if (![delegate isKindOfClass:[SDLUIKitSceneDelegate class]]) return;
+    UIWindow *previous = delegate.window;
+    delegate.window = window;
+    if (previous != window) previous.hidden = YES;
+}
